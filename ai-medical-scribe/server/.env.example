# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=medical_scribe_db
DB_PORT=3306
# Set to "true" to require TLS on the DB connection (recommended for any non-local DB host).
DB_SSL=false

# JWT signing secret — required, at least 32 characters, must NOT equal MEDICAL_DATA_ENCRYPTION_KEY.
# The server refuses to start if this is missing/short/reused.
JWT_SECRET=replace_with_a_different_long_random_value
JWT_EXPIRE=30d

# Data encryption key for consultation and patient fields at rest — required, at least 32
# characters, must NOT equal JWT_SECRET. The server refuses to start if this is missing/short/reused.
MEDICAL_DATA_ENCRYPTION_KEY=replace_with_a_different_long_random_value

# CORS
CORS_ORIGIN=http://localhost:5174

# Groq — used by routes/notes.js (SOAP note generation) and routes/transcribe.js (Whisper fallback)
GROQ_API_KEY=your_groq_api_key_here

# AssemblyAI — used by routes/diarize.js (speaker diarization). Required; the server refuses
# to start without it.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Python AI backend (backend/main.py) — used for per-utterance transcription/translation
# and voice-based doctor/patient identification.
AI_API_URL=http://localhost:8000
